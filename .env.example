# Copiar a .env (no versionado) y completar. Mismos nombres que CSAT Hogar / claro_CR_Recurrencia.
# Oracle: lectura de INVITADO_15.TBL_ENC_SOPORTE_FALLAS
# (las mismas del proceso de descarga; allá ORACLE_SERVICE_NAME aquí se llama ORACLE_DBNAME)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DBNAME=

# Yellowbrick: red FTTH propia / neutra en la base descargable (las del .env de CR_REC_UMM).
# Si faltan, la corrida sigue y avisa en Calidad de datos.
YELLOWBRICK_HOST=
YELLOWBRICK_PORT=
YELLOWBRICK_USER=
YELLOWBRICK_PASSWORD=

# SFTP LAN: publicación del tablero (las del .env de CR_REC_UMM)
SFTP_HOST_LAN=
SFTP_PORT_LAN=
SFTP_USER_LAN=
SFTP_PASS_LAN=
